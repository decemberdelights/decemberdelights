# Copy to .env.local for local dev. NEVER commit .env.local (it is git-ignored).
ENV=development
HOST=0.0.0.0
PORT=10000
JWT_SECRET=change-me-to-random-64-hex
ADMIN_DEFAULT_PASSWORD=change-me
ADMIN_USERNAME=change-me
CORS_ORIGINS=http://localhost:3000,https://decemberdelights.in,https://www.decemberdelights.in
FRONTEND_URL=https://www.decemberdelights.in
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=paste-service-role-key-here
RAZORPAY_KEY_ID=paste-key-id-here
RAZORPAY_KEY_SECRET=paste-key-secret-here
GMAIL_USER=info@decemberdelights.in
GMAIL_APP_PASSWORD=paste-16-char-app-password-here
ADMIN_EMAIL=info@decemberdelights.in
BACKEND_URL=http://localhost:10000
NEXT_PUBLIC_API_URL=http://localhost:10000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=paste-anon-key-here
NEXT_PUBLIC_RAZORPAY_KEY_ID=paste-key-id-here
NEXT_PUBLIC_SITE_URL=https://www.decemberdelights.in
NODE_ENV=development
# Hybrid storage (Hostinger 50GB + Supabase free 1GB): hybrid|local|supabase. Default hybrid.
# hybrid = new menu/product images -> /uploads/public (Nginx 1yr cache), new franchise/career docs -> /uploads/private (admin-only /api/files/*).
# Old https://*.supabase.co URLs keep working (read + delete fallback).
STORAGE_MODE=hybrid
# UPLOAD_ROOT=/var/www/decemberdelights/uploads (set on server via systemd Environment or backend/.env). Local default: <repo>/uploads
# UPLOAD_ROOT=/var/www/decemberdelights/uploads
